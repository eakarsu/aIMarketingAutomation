generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= USER & AUTH =============
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  firstName         String
  lastName          String
  company           String?
  phone             String?
  timezone          String?  @default("America/New_York")
  notificationPrefs String?  @default("{}")
  brandingSettings  String?  @default("{}")
  role              UserRole @default(USER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaigns         Campaign[]
  contacts          Contact[]
  templates         Template[]
  automations       Automation[]
  landingPages      LandingPage[]
  forms             Form[]
  reviews           Review[]
  integrations      Integration[]
  aiGenerations     AIGeneration[]
  segments          Segment[]
  tags              Tag[]
  customFields      CustomField[]
  images            ImageLibrary[]
  abTests           ABTest[]
  aiSegments        AISegment[]
  aiJourneys        AIJourney[]
  aiAttributions    AIAttribution[]
  aiBudgets         AIBudget[]
  aiFatigues        AIFatigue[]
  aiPersonas        AIPersona[]
  aiInfluencers     AIInfluencer[]
  aiHashtags        AIHashtag[]
  aiLandingPages    AILandingPageTemplate[]
  aiEmailCampaigns  AIEmailCampaign[]
  passwordResets    PasswordReset[]
  emailVerified     Boolean                 @default(false)
  verificationToken String?                 @unique

  sourceConnections  SourceConnection[]
  marketingSyncRuns  MarketingSyncRun[]
  consentEvents      ConsentEvent[]
  suppressionEntries SuppressionEntry[]
  leadRecords        LeadRecord[]
  deliveryJobs       DeliveryJob[]
  attributionTouches AttributionTouch[]
  conversions        Conversion[]
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  USER
}

// ============= CAMPAIGNS =============
model Campaign {
  id                String                 @id @default(uuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id])
  name              String
  description       String?
  type              CampaignType
  status            CampaignStatus         @default(DRAFT)
  subject           String?
  content           String?
  htmlContent       String?
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  approvalStatus    OutreachApprovalStatus @default(NOT_REQUIRED)
  domainAuth        Json?
  quietHours        Json?
  frequencyCap7Days Int                    @default(3)
  aiGenerated       Boolean                @default(false)
  sensitiveSegment  Boolean                @default(false)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])
  segmentId  String?
  segment    Segment?  @relation(fields: [segmentId], references: [id])

  recipients         CampaignRecipient[]
  analytics          CampaignAnalytics[]
  abTests            ABTest[]
  outreachApproval   OutreachApproval?
  deliveryJobs       DeliveryJob[]
  attributionTouches AttributionTouch[]
}

enum CampaignType {
  EMAIL
  SMS
  SOCIAL_MEDIA
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

model CampaignRecipient {
  id             String          @id @default(uuid())
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id])
  status         RecipientStatus @default(PENDING)
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime        @default(now())

  @@unique([campaignId, contactId])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
  FAILED
}

model CampaignAnalytics {
  id           String   @id @default(uuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  totalSent    Int      @default(0)
  delivered    Int      @default(0)
  opened       Int      @default(0)
  clicked      Int      @default(0)
  bounced      Int      @default(0)
  unsubscribed Int      @default(0)
  conversions  Int      @default(0)
  revenue      Float    @default(0)
  recordedAt   DateTime @default(now())
}

// ============= TEMPLATES =============
model Template {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  name        String
  description String?
  type        TemplateType
  subject     String?
  content     String
  htmlContent String?
  category    String?
  isPublic    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  campaigns       Campaign[]
  automationSteps AutomationStep[]
}

enum TemplateType {
  EMAIL
  SMS
  SOCIAL_POST
  LANDING_PAGE
}

// ============= CONTACTS =============
model Contact {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  email                 String
  phone                 String?
  firstName             String?
  lastName              String?
  company               String?
  status                ContactStatus @default(ACTIVE)
  source                String?
  optedOutAt            DateTime?
  birthday              DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  region                PrivacyRegion @default(UNKNOWN)
  timezoneOffsetMinutes Int           @default(0)
  sourceUpdatedAt       DateTime?
  sourceDigest          String?
  dataQualityScore      Float?

  tags                  ContactTag[]
  customFieldValues     CustomFieldValue[]
  segments              ContactSegment[]
  campaignRecipients    CampaignRecipient[]
  automationEnrollments AutomationEnrollment[]
  formSubmissions       FormSubmission[]
  reviews               Review[]
  sourceMappings        ContactSourceMapping[]
  consentEvents         ConsentEvent[]
  suppressionEntries    SuppressionEntry[]
  leadRecord            LeadRecord?
  deliveryJobs          DeliveryJob[]
  attributionTouches    AttributionTouch[]
  conversions           Conversion[]

  @@unique([userId, email])
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  INACTIVE
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  contacts ContactTag[]

  @@unique([userId, name])
}

model ContactTag {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([contactId, tagId])
}

model CustomField {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  name      String
  fieldType FieldType
  options   String? // JSON array for dropdown options
  required  Boolean   @default(false)
  createdAt DateTime  @default(now())

  values CustomFieldValue[]

  @@unique([userId, name])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  URL
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([contactId, customFieldId])
}

// ============= SEGMENTATION =============
model Segment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  description   String?
  rules         String // JSON rules for dynamic segmentation
  isAISuggested Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts    ContactSegment[]
  campaigns   Campaign[]
  automations Automation[]
}

model ContactSegment {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  segmentId String
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([contactId, segmentId])
}

// ============= AUTOMATION =============
model Automation {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  name        String
  description String?
  type        AutomationType
  status      AutomationStatus @default(INACTIVE)
  trigger     String // JSON trigger configuration
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id])

  steps       AutomationStep[]
  enrollments AutomationEnrollment[]
}

enum AutomationType {
  DRIP
  TRIGGER
  BIRTHDAY
  REENGAGEMENT
  WELCOME
}

enum AutomationStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

model AutomationStep {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order        Int
  type         StepType
  delayMinutes Int        @default(0)
  templateId   String?
  template     Template?  @relation(fields: [templateId], references: [id])
  config       String? // JSON configuration
  createdAt    DateTime   @default(now())

  enrollmentSteps EnrollmentStep[]
}

enum StepType {
  EMAIL
  SMS
  WAIT
  CONDITION
  TAG_ADD
  TAG_REMOVE
  WEBHOOK
}

model AutomationEnrollment {
  id           String           @id @default(uuid())
  automationId String
  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status       EnrollmentStatus @default(ACTIVE)
  currentStep  Int              @default(0)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?

  steps EnrollmentStep[]
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

model EnrollmentStep {
  id           String               @id @default(uuid())
  enrollmentId String
  enrollment   AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         AutomationStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status       StepStatus           @default(PENDING)
  scheduledAt  DateTime?
  executedAt   DateTime?
  createdAt    DateTime             @default(now())
}

enum StepStatus {
  PENDING
  SCHEDULED
  EXECUTED
  SKIPPED
  FAILED
}

// ============= CONTENT =============
model LandingPage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  slug        String   @unique
  htmlContent String
  cssContent  String?
  jsContent   String?
  isPublished Boolean  @default(false)
  views       Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  forms Form[]
}

model Form {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  name          String
  description   String?
  fields        String // JSON array of form fields
  submitAction  String? // JSON action configuration
  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id        String   @id @default(uuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  data      String // JSON submission data
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ImageLibrary {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  filename      String
  url           String
  mimeType      String
  size          Int
  isAIGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ============= ANALYTICS & A/B TESTING =============
model ABTest {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name          String
  status        ABTestStatus @default(RUNNING)
  winnerVariant String?
  createdAt     DateTime     @default(now())
  endedAt       DateTime?

  variants ABTestVariant[]
}

enum ABTestStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

model ABTestVariant {
  id          String   @id @default(uuid())
  abTestId    String
  abTest      ABTest   @relation(fields: [abTestId], references: [id], onDelete: Cascade)
  name        String
  subject     String?
  content     String?
  percentage  Float    @default(50)
  sent        Int      @default(0)
  opened      Int      @default(0)
  clicked     Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
}

// ============= REPUTATION / REVIEWS =============
model Review {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id])
  platform    ReviewPlatform
  externalId  String?
  rating      Int
  content     String?
  authorName  String
  authorEmail String?
  status      ReviewStatus   @default(PENDING)
  response    String?
  respondedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum ReviewPlatform {
  GOOGLE
  YELP
  FACEBOOK
  TRUSTPILOT
  CUSTOM
}

enum ReviewStatus {
  PENDING
  RESPONDED
  IGNORED
}

// ============= INTEGRATIONS =============
model Integration {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  type       IntegrationType
  name       String
  config     String // Encrypted JSON configuration
  status     IntegrationStatus @default(ACTIVE)
  lastSyncAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum IntegrationType {
  EMAIL_SENDGRID
  EMAIL_MAILGUN
  EMAIL_SES
  SMS_TWILIO
  SMS_MESSAGEBIRD
  SOCIAL_FACEBOOK
  SOCIAL_INSTAGRAM
  SOCIAL_TWITTER
  SOCIAL_LINKEDIN
  ADS_GOOGLE
  ADS_FACEBOOK
  REVIEW_GOOGLE
  REVIEW_YELP
  CRM_SALESFORCE
  CRM_HUBSPOT
  BOOKING_CALENDLY
  BOOKING_ACUITY
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

// ============= GOVERNED CUSTOMER OPERATIONS =============

model SourceConnection {
  id              String                 @id @default(uuid())
  userId          String
  name            String
  kind            CustomerSourceKind
  direction       SyncDirection
  status          SourceConnectionStatus @default(INACTIVE)
  configEncrypted String
  cursor          String?
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mappings ContactSourceMapping[]
  syncRuns MarketingSyncRun[]

  @@unique([userId, kind, name])
  @@index([userId, status])
}

model ContactSourceMapping {
  id              String    @id @default(uuid())
  connectionId    String
  contactId       String
  externalId      String
  remoteDigest    String
  lastSyncedAt    DateTime  @default(now())
  remoteUpdatedAt DateTime?
  deletedAt       DateTime?

  connection SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact    Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@unique([connectionId, contactId])
  @@index([contactId])
  @@index([connectionId, deletedAt])
}

model MarketingSyncRun {
  id             String        @id @default(uuid())
  userId         String
  connectionId   String
  direction      SyncDirection
  status         SyncRunStatus @default(QUEUED)
  idempotencyKey String
  cursorBefore   String?
  cursorAfter    String?
  pulled         Int           @default(0)
  pushed         Int           @default(0)
  deduplicated   Int           @default(0)
  deleted        Int           @default(0)
  conflicts      Int           @default(0)
  error          Json?
  attempt        Int           @default(0)
  maxAttempts    Int           @default(3)
  availableAt    DateTime      @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([status, availableAt])
  @@index([connectionId, createdAt])
}

model ConsentEvent {
  id              String          @id @default(uuid())
  userId          String
  contactId       String
  channel         OutreachChannel
  status          ConsentStatus
  lawfulBasis     LawfulBasis
  source          String
  evidenceDigest  String
  privacyNoticeAt DateTime?
  expiresAt       DateTime?
  occurredAt      DateTime
  createdAt       DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, channel, occurredAt])
}

model SuppressionEntry {
  id           String             @id @default(uuid())
  userId       String
  contactId    String?
  identityHash String
  channel      SuppressionChannel
  reason       SuppressionReason
  region       PrivacyRegion
  active       Boolean            @default(true)
  source       String
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([userId, identityHash, channel])
  @@index([userId, active])
  @@index([contactId])
}

model LeadRecord {
  id            String        @id @default(uuid())
  userId        String
  contactId     String        @unique
  state         LeadState     @default(NEW)
  ownerId       String?
  handoffStatus HandoffStatus @default(NONE)
  retryAt       DateTime?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transitions LeadTransition[]

  @@index([userId, state])
  @@index([ownerId, state])
  @@index([retryAt])
}

model LeadTransition {
  id           String    @id @default(uuid())
  leadId       String
  fromState    LeadState
  toState      LeadState
  reason       String
  actorId      String
  approvalId   String?
  conversionId String?
  occurredAt   DateTime  @default(now())

  lead LeadRecord @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
}

model OutreachApproval {
  id           String                 @id @default(uuid())
  campaignId   String                 @unique
  status       OutreachApprovalStatus @default(PENDING)
  requestedBy  String
  reviewedBy   String?
  attestations Json?
  comment      String?
  requestedAt  DateTime               @default(now())
  decidedAt    DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DeliveryJob {
  id                String            @id @default(uuid())
  userId            String
  campaignId        String
  contactId         String
  channel           OutreachChannel
  status            DeliveryJobStatus @default(QUEUED)
  policyDecision    Json
  idempotencyKey    String
  attempt           Int               @default(0)
  maxAttempts       Int               @default(3)
  availableAt       DateTime          @default(now())
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  cancelRequestedAt DateTime?
  provider          String?
  providerMessageId String?
  providerReceipt   Json?
  error             Json?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attempts      DeliveryAttempt[]
  webhookEvents WebhookDelivery[]

  @@unique([userId, idempotencyKey])
  @@unique([provider, providerMessageId])
  @@index([status, availableAt])
  @@index([campaignId, status])
  @@index([contactId, createdAt])
}

model DeliveryAttempt {
  id                String    @id @default(uuid())
  deliveryJobId     String
  attempt           Int
  provider          String
  requestDigest     String
  providerMessageId String?
  status            String
  errorCode         String?
  retryable         Boolean   @default(false)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  deliveryJob DeliveryJob @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)

  @@unique([deliveryJobId, attempt])
  @@index([status, startedAt])
}

model WebhookDelivery {
  id              String    @id @default(uuid())
  provider        String
  eventId         String
  eventType       String
  payloadDigest   String
  signatureDigest String
  deliveryJobId   String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  deliveryJob DeliveryJob? @relation(fields: [deliveryJobId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([deliveryJobId, receivedAt])
}

model AttributionTouch {
  id         String   @id @default(uuid())
  userId     String
  contactId  String
  campaignId String?
  channel    String
  eventType  String
  externalId String?
  occurredAt DateTime
  metadata   Json?
  createdAt  DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  credits  AttributionCredit[]

  @@unique([userId, externalId])
  @@index([contactId, occurredAt])
  @@index([campaignId, occurredAt])
}

model Conversion {
  id         String   @id @default(uuid())
  userId     String
  contactId  String
  externalId String
  type       String
  value      Decimal? @db.Decimal(18, 2)
  currency   String?
  occurredAt DateTime
  metadata   Json?
  createdAt  DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  credits AttributionCredit[]

  @@unique([userId, externalId])
  @@index([contactId, occurredAt])
}

model AttributionCredit {
  id           String   @id @default(uuid())
  conversionId String
  touchId      String
  model        String
  credit       Decimal  @db.Decimal(8, 7)
  createdAt    DateTime @default(now())

  conversion Conversion       @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  touch      AttributionTouch @relation(fields: [touchId], references: [id], onDelete: Cascade)

  @@unique([conversionId, touchId, model])
  @@index([touchId])
}

enum CustomerSourceKind {
  CRM
  EMAIL
  CALENDAR
  ENRICHMENT
  CONSENT
  SUPPRESSION
}

enum SyncDirection {
  PULL
  PUSH
  BIDIRECTIONAL
}

enum SourceConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  COMPLETED
  PARTIAL
  FAILED
