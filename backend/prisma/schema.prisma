// ============= AI EMAIL CAMPAIGN WRITER =============
model AIEmailCampaign {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  name               String
  campaignType       String // welcome, promotional, newsletter, re-engagement, announcement, product-launch, event, seasonal
  subject            String
  previewText        String?
  body               String   @db.Text
  sections           String?  @db.Text // JSON array of email sections
  ctaText            String?
  ctaUrl             String?
  tone               String?
  industry           String?
  audience           String?
  estimatedOpenRate  Float?
  estimatedClickRate Float?
  abVariants         String?  @db.Text // JSON array of A/B test subject line variants
  sendTimeRec        String? // Recommended send time
  tips               String?  @db.Text // JSON array of optimization tips
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
