// ============= AI GENERATIONS =============
model AIGeneration {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      AIGenerationType
  prompt    String
  result    String
  metadata  String? // JSON metadata
  createdAt DateTime         @default(now())
}

enum AIGenerationType {
  CONTENT
  IMAGE
  SUBJECT_LINE
  SEND_TIME
  SEGMENTATION
  CAMPAIGN_IDEA
  REVIEW_RESPONSE
  SOCIAL_POST
  AD_COPY
  PREDICTION
  SEGMENT_BUILDER
  JOURNEY_OPTIMIZER
  ATTRIBUTION_MODEL
  BUDGET_ALLOCATOR
  FATIGUE_DETECTOR
  PERSONA_CREATOR
  INFLUENCER_MATCHER
  HASHTAG_GENERATOR
  LANDING_PAGE_BUILDER
  EMAIL_CAMPAIGN_WRITER
}

// ============= AI SEGMENT BUILDER =============
model AISegment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  description  String?
  criteria     String // JSON criteria
  contactCount Int      @default(0)
  confidence   Float    @default(0)
  insights     String? // JSON insights
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============= AI CUSTOMER JOURNEY =============
model AIJourney {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  description     String?
  stages          String // JSON stages
  touchpoints     String? // JSON touchpoints
  recommendations String? // JSON recommendations
  conversionRate  Float    @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============= AI ATTRIBUTION MODEL =============
model AIAttribution {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  modelType   String // first-touch, last-touch, linear, time-decay, data-driven
  channels    String // JSON channels with attribution percentages
  insights    String? // JSON insights
  revenue     Float    @default(0)
  conversions Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============= AI BUDGET ALLOCATION =============
model AIBudget {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  totalBudget     Float
  allocations     String // JSON allocations per channel
  recommendations String? // JSON recommendations
  projectedROI    Float    @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============= AI FATIGUE DETECTION =============
model AIFatigue {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  contactId       String?
  segmentName     String?
  fatigueScore    Float    @default(0)
  emailFrequency  Int      @default(0)
  openRateDecline Float    @default(0)
  recommendations String? // JSON recommendations
  status          String   @default("active")
  detectedAt      DateTime @default(now())
}

// ============= AI CUSTOMER PERSONA =============
